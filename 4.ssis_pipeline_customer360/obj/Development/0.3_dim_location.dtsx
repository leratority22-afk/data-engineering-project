  <DTS:Property
    DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\create_dwh_dim_location"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B1877071-735A-4785-BBE4-F9B1EA9229F0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_dwh_dim_location"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="IF OBJECT_ID('dbo.dwh_dim_location', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.dwh_dim_location&#xA;    (&#xA;        location_key INT IDENTITY(1,1) PRIMARY KEY,&#xA;&#xA;        province     NVARCHAR(100) NULL,&#xA;        city         NVARCHAR(100) NULL,&#xA;&#xA;        CONSTRAINT UQ_dim_location&#xA;            UNIQUE (province, city)&#xA;    );&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\load_dwh_dim_location"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{233C6007-252C-4F23-BAF9-A0B1D89C9FB7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_dwh_dim_location"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.dwh_dim_location&#xA;(&#xA;    province,&#xA;    city&#xA;)&#xA;SELECT DISTINCT&#xA;    NULLIF(LTRIM(RTRIM(s.province)), '') AS province,&#xA;&#xA;    NULLIF(LTRIM(RTRIM(s.city)), '') AS city&#xA;&#xA;FROM stg_customer360.[dbo].[stg_customer360_raw]AS s&#xA;&#xA;WHERE&#xA;    /* Do not load completely empty locations */&#xA;    (&#xA;        NULLIF(LTRIM(RTRIM(s.province)), '') IS NOT NULL&#xA;        OR&#xA;        NULLIF(LTRIM(RTRIM(s.city)), '') IS NOT NULL&#xA;    )&#xA;&#xA;    /* Prevent duplicate locations */&#xA;    AND NOT EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM dbo.dwh_dim_location AS d&#xA;        WHERE&#xA;            ISNULL(d.province, '') =&#xA;            ISNULL(NULLIF(LTRIM(RTRIM(s.province)), ''), '')&#xA;&#xA;            AND&#xA;&#xA;            ISNULL(d.city, '') =&#xA;            ISNULL(NULLIF(LTRIM(RTRIM(s.city)), ''), '')&#xA;    );&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\load_stg_dim_location"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0c828f28-a7e1-455c-ad14-9007c1356cb3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_stg_dim_location"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="USE stg_customer360;&#xA;GO&#xA;&#xA;INSERT INTO dbo.stg_dim_location&#xA;(&#xA;    province&#xA;      ,city&#xA;)&#xA;SELECT&#xA;   s.province&#xA;      ,s.city&#xA;FROM [stg_customer360].[dbo].[stg_customer360_raw]AS s&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.stg_dim_location AS d&#xA;    WHERE d.province = s.province&#xA;);&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\stg_dim_location"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4fd5e32b-b99b-4a37-9fa7-0c2d05887150}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="stg_dim_location"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="USE stg_customer360;&#xA;GO&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = 'stg_dim_location'&#xA;      AND schema_id = SCHEMA_ID('dbo')&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE dbo.stg_dim_location&#xA;    (&#xA;        province           NVARCHAR(100) NULL,&#xA;        city               NVARCHAR(100) NULL,&#xA;                 &#xA;    );&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
