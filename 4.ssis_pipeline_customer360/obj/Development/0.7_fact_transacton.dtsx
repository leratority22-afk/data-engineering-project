  <DTS:Property
    DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\create_dwh_fact_transaction"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0467DD4F-8C93-4620-918C-B1A7A6DAFA68}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_dwh_fact_transaction"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="/*========================================================&#xA;  CREATE DWH FACT TRANSACTION&#xA;========================================================*/&#xA;&#xA;USE dwh_customer360;&#xA;GO&#xA;&#xA;IF OBJECT_ID('dbo.dwh_fact_transaction', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.dwh_fact_transaction&#xA;    (&#xA;        transaction_key       INT IDENTITY(1,1) PRIMARY KEY,&#xA;&#xA;        client_key            INT NULL,&#xA;        account_key           INT NULL,&#xA;        location_key          INT NULL,&#xA;        transaction_type_key  INT NULL,&#xA;&#xA;        event_date             DATE NULL,&#xA;        amount                 DECIMAL(18,2) NULL,&#xA;        account_balance       DECIMAL(18,2) NULL&#xA;    );&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\create_stg_fact_transaction"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{CB44C0B7-0E05-41CB-9745-C486ED33E26F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_stg_fact_transaction"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="/*========================================================&#xA;  CREATE STAGING FACT TRANSACTION TABLE&#xA;  NO DATA CLEANING&#xA;========================================================*/&#xA;&#xA;USE stg_customer360;&#xA;GO&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = 'stg_fact_transaction'&#xA;      AND schema_id = SCHEMA_ID('dbo')&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE dbo.stg_fact_transaction&#xA;    (&#xA;        client_number       NVARCHAR(50) NULL,&#xA;        account_number      NVARCHAR(50) NULL,&#xA;        province            NVARCHAR(100) NULL,&#xA;        city                NVARCHAR(100) NULL,&#xA;        channel             NVARCHAR(100) NULL,&#xA;        transaction_type    NVARCHAR(100) NULL,&#xA;        event_date          NVARCHAR(100) NULL,&#xA;        amount              NVARCHAR(100) NULL,&#xA;        account_balance     NVARCHAR(100) NULL&#xA;    );&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\load_dwh_fact_transaction"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{EE433900-1209-4ECE-99B2-354BADB5AA71}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_dwh_fact_transaction"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.dwh_fact_transaction&#xA;(&#xA;    client_key,&#xA;    account_key,&#xA;    location_key,&#xA;    transaction_type_key,&#xA;    event_date,&#xA;    amount,&#xA;    account_balance&#xA;)&#xA;SELECT DISTINCT&#xA;&#xA;    c.client_key,&#xA;&#xA;    a.account_key,&#xA;&#xA;    l.location_key,&#xA;&#xA;    tt.transaction_type_key,&#xA;&#xA;    TRY_CONVERT&#xA;    (&#xA;        DATE,&#xA;        NULLIF(LTRIM(RTRIM(s.event_date)), '')&#xA;    ) AS event_date,&#xA;&#xA;    TRY_CONVERT&#xA;    (&#xA;        DECIMAL(18,2),&#xA;        NULLIF(LTRIM(RTRIM(s.amount)), '')&#xA;    ) AS amount,&#xA;&#xA;    TRY_CONVERT&#xA;    (&#xA;        DECIMAL(18,2),&#xA;        NULLIF(LTRIM(RTRIM(s.account_balance)), '')&#xA;    ) AS account_balance&#xA;&#xA;FROM dwh_customer360.dbo.dwh_fact_transaction AS s&#xA;&#xA;/* CLIENT */&#xA;LEFT JOIN dbo.dwh_dim_client AS c&#xA;    ON c.client_number =&#xA;       NULLIF(LTRIM(RTRIM(s.client_number)), '')&#xA;&#xA;/* ACCOUNT */&#xA;LEFT JOIN dbo.dwh_dim_account AS a&#xA;    ON a.account_number =&#xA;       NULLIF(LTRIM(RTRIM(s.account_number)), '')&#xA;&#xA;/* LOCATION */&#xA;LEFT JOIN dbo.dwh_dim_location AS l&#xA;    ON ISNULL(l.province, '') =&#xA;       ISNULL(NULLIF(LTRIM(RTRIM(s.province)), ''), '')&#xA;   AND&#xA;       ISNULL(l.city, '') =&#xA;       ISNULL(NULLIF(LTRIM(RTRIM(s.city)), ''), '')&#xA;&#xA;/* TRANSACTION TYPE */&#xA;LEFT JOIN dbo.dwh_dim_transaction_type AS tt&#xA;    ON tt.transaction_type =&#xA;       NULLIF(LTRIM(RTRIM(s.transaction_type)), '')&#xA;&#xA;WHERE&#xA;    NULLIF(LTRIM(RTRIM(s.transaction_type)), '') IS NOT NULL&#xA;&#xA;    /* Prevent duplicate fact records */&#xA;    AND NOT EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM dbo.dwh_fact_transaction AS f&#xA;        WHERE ISNULL(f.client_key, -1) =&#xA;              ISNULL(c.client_key, -1)&#xA;&#xA;          AND ISNULL(f.account_key, -1) =&#xA;              ISNULL(a.account_key, -1)&#xA;&#xA;          AND ISNULL(f.location_key, -1) =&#xA;              ISNULL(l.location_key, -1)&#xA;&#xA;          AND ISNULL(f.transaction_type_key, -1) =&#xA;              ISNULL(tt.transaction_type_key, -1)&#xA;&#xA;          AND ISNULL(f.event_date, '19000101') =&#xA;              ISNULL&#xA;              (&#xA;                  TRY_CONVERT&#xA;                  (&#xA;                      DATE,&#xA;                      NULLIF(LTRIM(RTRIM(s.event_date)), '')&#xA;                  ),&#xA;                  '19000101'&#xA;              )&#xA;&#xA;          AND ISNULL(f.amount, 0) =&#xA;              ISNULL&#xA;              (&#xA;                  TRY_CONVERT&#xA;                  (&#xA;                      DECIMAL(18,2),&#xA;                      NULLIF(LTRIM(RTRIM(s.amount)), '')&#xA;                  ),&#xA;                  0&#xA;              )&#xA;&#xA;          AND ISNULL(f.account_balance, 0) =&#xA;              ISNULL&#xA;              (&#xA;                  TRY_CONVERT&#xA;                  (&#xA;                      DECIMAL(18,2),&#xA;                      NULLIF(LTRIM(RTRIM(s.account_balance)), '')&#xA;                  ),&#xA;                  0&#xA;              )&#xA;    );&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\load_stg_fact_transaction"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C3A60DB7-5AF6-4195-BAB2-09CCCCCCFB18}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_stg_fact_transaction"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="USE stg_customer360;&#xA;GO&#xA;&#xA;INSERT INTO dbo.stg_fact_transaction&#xA;(&#xA;    client_number,&#xA;    account_number,&#xA;    province,&#xA;    city,&#xA;    channel,&#xA;    transaction_type,&#xA;    event_date,&#xA;    amount,&#xA;    account_balance&#xA;)&#xA;SELECT&#xA;    s.client_number,&#xA;    s.account_number,&#xA;    s.province,&#xA;    s.city,&#xA;    s.channel,&#xA;    s.transaction_type,&#xA;    s.event_date,&#xA;    s.amount,&#xA;    s.account_balance&#xA;FROM dbo.stg_customer360_raw AS s&#xA;WHERE s.transaction_type IS NOT NULL;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
