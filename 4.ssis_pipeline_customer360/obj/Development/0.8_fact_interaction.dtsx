    <DTS:Executable
      DTS:refId="Package\create_stg_fact_interaction"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2C5ABF94-D026-4DAF-BB1E-039C01BCE34B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_stg_fact_interaction"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="/*========================================================&#xA;  CREATE STAGING FACT INTERACTION TABLE&#xA;  NO DATA CLEANING&#xA;========================================================*/&#xA;&#xA;USE stg_customer360;&#xA;GO&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = 'stg_fact_interaction'&#xA;      AND schema_id = SCHEMA_ID('dbo')&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE dbo.stg_fact_interaction&#xA;    (&#xA;        client_number       NVARCHAR(50) NULL,&#xA;        account_number      NVARCHAR(50) NULL,&#xA;        province            NVARCHAR(100) NULL,&#xA;        city                NVARCHAR(100) NULL,&#xA;        channel             NVARCHAR(100) NULL,&#xA;        interaction_type    NVARCHAR(100) NULL,&#xA;        event_type          NVARCHAR(100) NULL,&#xA;        event_date          NVARCHAR(100) NULL,&#xA;        resolved_flag       NVARCHAR(100) NULL&#xA;    );&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\load_stg_fact_interaction"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{78859947-D7D9-48C4-93CD-2F8524084999}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_stg_fact_interaction"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="USE stg_customer360;&#xA;GO&#xA;&#xA;INSERT INTO dbo.stg_fact_interaction&#xA;(&#xA;    client_number,&#xA;    account_number,&#xA;    province,&#xA;    city,&#xA;    channel,&#xA;    interaction_type,&#xA;    event_type,&#xA;    event_date,&#xA;    resolved_flag&#xA;)&#xA;SELECT&#xA;    s.client_number,&#xA;    s.account_number,&#xA;    s.province,&#xA;    s.city,&#xA;    s.channel,&#xA;    s.interaction_type,&#xA;    s.event_type,&#xA;    s.event_date,&#xA;    s.resolved_flag&#xA;FROM dbo.stg_customer360_raw AS s&#xA;WHERE s.interaction_type IS NOT NULL;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
