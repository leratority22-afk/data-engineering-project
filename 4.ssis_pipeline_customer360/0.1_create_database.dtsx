      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="USE stg_customer360;&#xA;GO&#xA;&#xA;-- Create staging schema&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = 'stg_customer360'&#xA;)&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA stg_customer360 ');&#xA;END;&#xA;GO&#xA;&#xA;-- Create data warehouse schema&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = 'dwh_customer360'&#xA;)&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA dwh_customer360');&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\raw_data"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
