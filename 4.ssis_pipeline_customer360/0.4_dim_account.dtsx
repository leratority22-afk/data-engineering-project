  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\create_dwh_dim_account"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{84BD2DD8-1518-43E9-9A3C-3E42DD6BAAD2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_dwh_dim_account"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="/*========================================================&#xA;  3. CREATE DIM_ACCOUNT&#xA;========================================================*/&#xA;&#xA;IF OBJECT_ID('dbo.dwh_dim_account', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.dwh_dim_account&#xA;    (&#xA;        account_key      INT IDENTITY(1,1) PRIMARY KEY,&#xA;&#xA;        account_number   NVARCHAR(50) NULL,&#xA;        product_type     NVARCHAR(100) NULL,&#xA;        account_status   NVARCHAR(100) NULL,&#xA;        credit_limit     DECIMAL(18,2) NULL,&#xA;        loan_amount      DECIMAL(18,2) NULL,&#xA;&#xA;        CONSTRAINT UQ_dim_account&#xA;            UNIQUE (account_number)&#xA;    );&#xA;END;&#xA;GO&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\create_stg_dim_account"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{c6552172-c5d2-4b28-97f4-2cafefa9ff0a}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_stg_dim_account"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="USE stg_customer360;&#xA;GO&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = 'stg_dim_account'&#xA;      AND schema_id = SCHEMA_ID('dbo')&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE dbo.stg_dim_account&#xA;    (&#xA;        account_number     NVARCHAR(50) NULL,&#xA;        product_type       NVARCHAR(100) NULL,&#xA;        account_status     NVARCHAR(100) NULL,&#xA;        credit_limit       DECIMAL(18,2) NULL,&#xA;        loan_amount        DECIMAL(18,2) NULL,&#xA;       &#xA;    );&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\load_dwh_dim_account"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A41425E6-AC96-458D-AA94-D8F498D2F4E2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_dwh_dim_account"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="WITH src AS (&#xA;  SELECT&#xA;    account_number = NULLIF(LTRIM(RTRIM(s.account_number)), ''),&#xA;    product_type   = NULLIF(LTRIM(RTRIM(s.product_type)), ''),&#xA;    account_status = NULLIF(LTRIM(RTRIM(s.account_status)), ''),&#xA;    credit_limit   = TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM(s.credit_limit)), '')),&#xA;    loan_amount    = TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM(s.loan_amount)), '')),&#xA;    rn = ROW_NUMBER() OVER (&#xA;      PARTITION BY NULLIF(LTRIM(RTRIM(s.account_number)), '')&#xA;      ORDER BY (SELECT 0)  -- replace with meaningful ordering if available&#xA;    )&#xA;  FROM stg_customer360.dbo.stg_dim_account AS s&#xA;  WHERE NULLIF(LTRIM(RTRIM(s.account_number)), '') IS NOT NULL&#xA;)&#xA;INSERT INTO dwh_customer360.dbo.dwh_dim_account&#xA;(&#xA;  account_number,&#xA;  product_type,&#xA;  account_status,&#xA;  credit_limit,&#xA;  loan_amount&#xA;)&#xA;SELECT account_number, &#xA;product_type, &#xA;account_status, &#xA;credit_limit, &#xA;loan_amount&#xA;FROM src s&#xA;WHERE s.rn = 1&#xA;  AND NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dwh_customer360.dbo.dwh_dim_account d&#xA;    WHERE d.account_number = s.account_number&#xA;  );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\load_stg_dim_account"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{30141155-34d1-4714-b98e-bd29505a12d7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_stg_dim_account"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="USE stg_customer360;&#xA;GO&#xA;&#xA;INSERT INTO dbo.stg_dim_account&#xA;(&#xA;    account_number&#xA;      ,product_type&#xA;      ,account_status&#xA;      ,credit_limit&#xA;      ,loan_amount&#xA;)&#xA;SELECT&#xA;    account_number&#xA;      ,s.product_type&#xA;      ,s.account_status&#xA;      ,s.credit_limit&#xA;      ,s.loan_amount&#xA;FROM [stg_customer360].[dbo].[stg_customer360_raw]AS s&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.stg_dim_account AS d&#xA;    WHERE d.account_number = s.account_number&#xA;);&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
