  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\create_dim_event_type"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{004EF71B-BC2C-4172-9A27-3BDF359A9D07}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_dim_event_type"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="/*========================================================&#xA;  3. CREATE DIM_EVENT_TYPE&#xA;========================================================*/&#xA;&#xA;IF OBJECT_ID('dbo.dwh_dim_event_type', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.dwh_dim_event_type&#xA;    (&#xA;        event_type_key INT IDENTITY(1,1) PRIMARY KEY,&#xA;&#xA;        event_type NVARCHAR(100) NULL,&#xA;&#xA;        CONSTRAINT UQ_dim_event_type&#xA;            UNIQUE (event_type)&#xA;    );&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\create_stg_dim_event_type"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{204881a8-b5ca-4881-b3e6-6c48c6f1ab7f}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_stg_dim_event_type"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="USE stg_customer360;&#xA;GO&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = 'stg_dim_event_type'&#xA;      AND schema_id = SCHEMA_ID('dbo')&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE dbo.stg_dim_event_type&#xA;    (&#xA;         event_type         NVARCHAR(100) NULL,&#xA;        event_date         DATE NULL,&#xA;      &#xA;    );&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\load_dim_event_type"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E2C2E2B0-DBAA-40FD-BC12-37F0178EDB8D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_dim_event_type"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="/*========================================================&#xA;  4. LOAD EVENT TYPE FROM STAGING&#xA;     &#xA; &#xA;========================================================*/&#xA;&#xA;INSERT INTO dbo.dwh_dim_event_type&#xA;(&#xA;    event_type&#xA;)&#xA;SELECT DISTINCT&#xA;&#xA;    NULLIF(&#xA;        LTRIM(RTRIM(s.event_type)),&#xA;        ''&#xA;    ) AS event_type&#xA;&#xA;FROM stg_customer360.dbo.stg_dim_event_type AS s&#xA;&#xA;WHERE&#xA;    /* Do not load blank event types */&#xA;    NULLIF(&#xA;        LTRIM(RTRIM(s.event_type)),&#xA;        ''&#xA;    ) IS NOT NULL&#xA;&#xA;    /* Prevent duplicate event types */&#xA;    AND NOT EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM dbo.dwh_dim_event_type AS d&#xA;        WHERE d.event_type =&#xA;              NULLIF(&#xA;                  LTRIM(RTRIM(s.event_type)),&#xA;                  ''&#xA;              )&#xA;    );&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\load_stg_dim_event_type"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{13618cf8-a7a0-4a92-8034-9b03b10141fc}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_stg_dim_event_type"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="USE stg_customer360;&#xA;GO&#xA;&#xA;INSERT INTO dbo.stg_dim_event_type&#xA;(&#xA;   event_type&#xA;      ,event_date&#xA;)&#xA;SELECT&#xA;  s.event_type&#xA;      ,s.event_date&#xA;FROM [stg_customer360].[dbo].[stg_customer360_raw]AS s&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.stg_dim_event_type AS d&#xA;    WHERE d.event_type = s.event_type&#xA;);&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
