  <DTS:Property
    DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\create_dwh_transation_type"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4DD35347-2071-420D-B948-E839702F456D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_dwh_transation_type"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="/*========================================================&#xA;  3. CREATE DIM_TRANSACTION_TYPE&#xA;========================================================*/&#xA;&#xA;IF OBJECT_ID('dbo.dwh_dim_transaction_type', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.dwh_dim_transaction_type&#xA;    (&#xA;        transaction_type_key INT IDENTITY(1,1) PRIMARY KEY,&#xA;&#xA;        transaction_type NVARCHAR(100) NULL,&#xA;&#xA;        CONSTRAINT UQ_dim_transaction_type&#xA;            UNIQUE (transaction_type)&#xA;    );&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\create_stg_dim_transaction_type"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{512198d8-b152-4b9a-878e-984881317c85}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_stg_dim_transaction_type"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="USE stg_customer360;&#xA;GO&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = 'stg_dim_transaction_type'&#xA;      AND schema_id = SCHEMA_ID('dbo')&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE dbo.stg_dim_transaction_type&#xA;    (&#xA;        channel   NVARCHAR(100) NULL,&#xA;      transaction_type   NVARCHAR(100) NULL,&#xA;    );&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\load_dwh_dim_transaction_type"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2C4705C5-5CC0-45B7-9CF3-76C62F6BDB05}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_dwh_dim_transaction_type"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="/*========================================================&#xA;  4. LOAD TRANSACTION TYPE FROM STAGING&#xA;    &#xA;========================================================*/&#xA;&#xA;INSERT INTO dbo.dwh_dim_transaction_type&#xA;(&#xA;    transaction_type&#xA;)&#xA;SELECT DISTINCT&#xA;&#xA;    NULLIF(&#xA;        LTRIM(RTRIM(s.transaction_type)),&#xA;        ''&#xA;    ) AS transaction_type&#xA;&#xA;FROM stg_customer360.dbo.stg_dim_transaction_type AS s&#xA;&#xA;WHERE&#xA;    /* Do not load blank transaction types */&#xA;    NULLIF(&#xA;        LTRIM(RTRIM(s.transaction_type)),&#xA;        ''&#xA;    ) IS NOT NULL&#xA;&#xA;    /* Prevent duplicate transaction types */&#xA;    AND NOT EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM dbo.dwh_dim_transaction_type AS d&#xA;        WHERE d.transaction_type =&#xA;              NULLIF(&#xA;                  LTRIM(RTRIM(s.transaction_type)),&#xA;                  ''&#xA;              )&#xA;    );&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\load_stg_dim_transaction_type"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{d275e74b-7d4b-450b-a1c7-1fb845f2ee65}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_stg_dim_transaction_type"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3FBC964-B242-48C6-B932-4E487E43AA93}"
          SQLTask:SqlStatementSource="USE stg_customer360;&#xA;GO&#xA;&#xA;INSERT INTO dbo.stg_dim_transaction_type&#xA;(&#xA;    channel,&#xA;    transaction_type&#xA;)&#xA;SELECT&#xA;   s. channel,&#xA;   s.transaction_type&#xA;FROM [stg_customer360].[dbo].[stg_customer360_raw]AS s&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.stg_dim_transaction_type AS d&#xA;    WHERE d.channel = s.channel&#xA;);&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
